---------------------------------------------------------------------
-- STATE
---------------------------------------------------------------------

type WeaponState = {
	Ammo: number,
	LastShot: number,
	Reloading: boolean,
	ReloadToken: number,
	Sequence: number,
	Shots: number,
	Hits: number,
	Headshots: number,
	Damage: number,
	Violations: number,
}

type PlayerState = {
	Weapons: {[string]: WeaponState},
	LastRequest: number,
	Requests: number,
}

local states: {[Player]: PlayerState} = {}

local function createWeaponState(config: WeaponConfig): WeaponState
	return {
		Ammo = config.MagazineSize,
		LastShot = -math.huge,
		Reloading = false,
		ReloadToken = 0,
		Sequence = 0,
		Shots = 0,
		Hits = 0,
		Headshots = 0,
		Damage = 0,
		Violations = 0,
	}
end

local function createPlayerState(): PlayerState
	local result: PlayerState = {
		Weapons = {},
		LastRequest = 0,
		Requests = 0,
	}

	for weaponName, config in pairs(WEAPONS) do
		result.Weapons[weaponName] = createWeaponState(config)
	end

	return result
end

local function getState(player: Player): PlayerState
	local state = states[player]
	if state then
		return state
	end

	state = createPlayerState()
	states[player] = state
	return state
end

---------------------------------------------------------------------
-- SECURITY HELPERS
---------------------------------------------------------------------

local function violation(player: Player, reason: string)
	local state = getState(player)
	state.Requests += 1

	-- Only count suspicious requests; don't automatically punish here.
	for _, weaponState in pairs(state.Weapons) do
		weaponState.Violations += 0
	end

	warn(string.format(
		"[SoftboyzSecurity] %s (%d): %s",
		player.Name,
		player.UserId,
		reason
	))

	CombatState:FireClient(player, {
		Type = "Security",
		Status = "Rejected",
		Reason = reason,
	})
end

local function finiteNumber(value: unknown): boolean
	return typeof(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function validVector3(value: unknown): boolean
	if typeof(value) ~= "Vector3" then
		return false
	end

	return finiteNumber(value.X)
		and finiteNumber(value.Y)
		and finiteNumber(value.Z)
end

local function safeUnit(vector: Vector3): Vector3?
	if vector.Magnitude < 1e-5 then
		return nil
	end

	return vector.Unit
end

---------------------------------------------------------------------
-- CHARACTER / WEAPON VALIDATION
---------------------------------------------------------------------

local function getCharacter(player: Player): Model?
	local character = player.Character
	if not character then
		return nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")

	if not humanoid or humanoid.Health <= 0 or not root then
		return nil
	end

	return character
end

local function getEquippedWeapon(player: Player): Tool?
	local character = player.Character
	if not character then
		return nil
	end

	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Tool") and WEAPONS[child.Name] then
			return child
		end
	end

	return nil
end

local function weaponMatchesRequest(player: Player, weaponName: string): boolean
	local equipped = getEquippedWeapon(player)

	if not equipped then
		return false
	end

	return equipped.Name == weaponName
end

---------------------------------------------------------------------
-- RAYCAST
---------------------------------------------------------------------

local function makeRaycastParams(character: Model): RaycastParams
	local params = RaycastParams.new()

	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {character}

	params.IgnoreWater = true
	params.RespectCanCollide = true

	return params
end

local function findHumanoidFromHit(instance: Instance?): (Humanoid?, Model?, BasePart?)
	if not instance then
		return nil, nil, nil
	end

	local current: Instance? = instance

	while current and current ~= Workspace do
		if current:IsA("Model") then
			local humanoid = current:FindFirstChildOfClass("Humanoid")

			if humanoid then
				local hitPart = if instance:IsA("BasePart") then instance else nil
				return humanoid, current, hitPart
			end
		end

		current = current.Parent
	end

	return nil, nil, nil
end

---------------------------------------------------------------------
-- DAMAGE
---------------------------------------------------------------------

local function isFriendly(attacker: Player, victimModel: Model): boolean
	local victimPlayer = Players:GetPlayerFromCharacter(victimModel)

	if not victimPlayer then
		return false
	end

	-- Standard team protection.
	if attacker.Team ~= nil and victimPlayer.Team == attacker.Team then
		return true
	end

	return false
end

local function calculateDamage(
	config: WeaponConfig,
	hitPart: BasePart?
): (number, boolean)
	local headshot = false

	if hitPart then
		headshot =
			hitPart.Name == "Head"
			or hitPart:GetAttribute("DamageZone") == "Head"
	end

	local damage = config.Damage

	if headshot then
		damage *= config.HeadMultiplier
	end

	return math.floor(damage + 0.5), headshot
end

---------------------------------------------------------------------
-- SERVER SHOT
---------------------------------------------------------------------

local function processShot(
	player: Player,
	payload: any
): boolean

	if typeof(payload) ~= "table" then
		violation(player, "payload_not_table")
		return false
	end

	local weaponName = payload.weapon
	local origin = payload.origin
	local direction = payload.direction
	local sequence = payload.sequence

	if typeof(weaponName) ~= "string" then
		violation(player, "invalid_weapon_name")
		return false
	end

	local config = WEAPONS[weaponName]
	if not config then
		violation(player, "unknown_weapon")
		return false
	end

	if not validVector3(origin) or not validVector3(direction) then
		violation(player, "invalid_vector")
		return false
	end

	if typeof(sequence) ~= "number"
		or sequence % 1 ~= 0
		or sequence < 1
		or sequence > 2^31
	then
		violation(player, "invalid_sequence")
		return false
	end

	local playerState = getState(player)
	local weaponState = playerState.Weapons[weaponName]

	if weaponState.Reloading then
		violation(player, "shot_while_reloading")
		return false
	end

	-- Replay protection.
	if sequence <= weaponState.Sequence then
		violation(player, "replayed_sequence")
		return false
	end

	weaponState.Sequence = sequence

	-----------------------------------------------------------------
	-- RATE LIMIT
	-----------------------------------------------------------------

	local now = os.clock()
	local minInterval = 1 / config.FireRate

	if now - weaponState.LastShot < minInterval * 0.88 then
		violation(player, "fire_rate_exceeded")
		return false
	end

	weaponState.LastShot = now

	-----------------------------------------------------------------
	-- EQUIPPED WEAPON
	-----------------------------------------------------------------

	if not weaponMatchesRequest(player, weaponName) then
		violation(player, "weapon_not_equipped")
		return false
	end

	-----------------------------------------------------------------
	-- CHARACTER
	-----------------------------------------------------------------

	local character = getCharacter(player)
	if not character then
		return false
	end

	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return false
	end

	-----------------------------------------------------------------
	-- ORIGIN VALIDATION
	-----------------------------------------------------------------

	local muzzle = character:FindFirstChild("Muzzle", true)

	local expectedOrigin = root.Position

	if muzzle and muzzle:IsA("BasePart") then
		expectedOrigin = muzzle.Position
	end

	if (origin - expectedOrigin).Magnitude > config.OriginTolerance then
		violation(player, "invalid_shot_origin")
		return false
	end

	-----------------------------------------------------------------
	-- DIRECTION VALIDATION
	-----------------------------------------------------------------

	local unitDirection = safeUnit(direction)
	if not unitDirection then
		violation(player, "zero_direction")
		return false
	end

	-- The server does not accept arbitrary impossible directions.
	-- We compare to the server-visible root orientation as a basic sanity
	-- gate. A more advanced implementation can use replicated camera data
	-- from the game's own controller.
	local forward = root.CFrame.LookVector
	local dot = math.clamp(forward:Dot(unitDirection), -1, 1)
	local angle = math.deg(math.acos(dot))

	if angle > config.MaxAimAngleDegrees + 85 then
		violation(player, "impossible_shot_angle")
		return false
	end

	-----------------------------------------------------------------
	-- AMMO
	-----------------------------------------------------------------

	if weaponState.Ammo <= 0 then
		CombatState:FireClient(player, {
			Type = "Ammo",
			Weapon = weaponName,
			Ammo = 0,
			MagazineSize = config.MagazineSize,
		})

		return false
	end

	weaponState.Ammo -= 1
	weaponState.Shots += 1

	-----------------------------------------------------------------
	-- RAYCAST
	-----------------------------------------------------------------

	local params = makeRaycastParams(character)

	local result = Workspace:Raycast(
		origin,
		unitDirection * config.Range,
		params
	)

	local hitPosition =
		if result
		then result.Position
		else origin + unitDirection * config.Range

	local hitHumanoid: Humanoid?
	local hitModel: Model?
	local hitPart: BasePart?

	if result then
		hitHumanoid, hitModel, hitPart = findHumanoidFromHit(result.Instance)
	end

	-----------------------------------------------------------------
	-- DAMAGE
	-----------------------------------------------------------------

	local didHit = false
	local damageDone = 0
	local headshot = false

	if hitHumanoid and hitModel and hitPart then
		if hitHumanoid.Health > 0 and not isFriendly(player, hitModel) then
			damageDone, headshot = calculateDamage(config, hitPart)

			-- Server decides the damage.
			hitHumanoid:TakeDamage(damageDone)

			didHit = true
			weaponState.Hits += 1
			weaponState.Damage += damageDone

			if headshot then
				weaponState.Headshots += 1
			end
		end
	end

	-----------------------------------------------------------------
	-- REPLICATION
	-----------------------------------------------------------------

	ReplicateShot:FireAllClients({
		Type = "Shot",
		Player = player,
		Weapon = weaponName,

		Origin = origin,
		HitPosition = hitPosition,

		Hit = didHit,
		Headshot = headshot,
		Damage = damageDone,

		Sequence = sequence,
	})

	CombatState:FireClient(player, {
		Type = "Ammo",
		Weapon = weaponName,
		Ammo = weaponState.Ammo,
		MagazineSize = config.MagazineSize,
	})

	return true
end

---------------------------------------------------------------------
-- SHOOT REMOTE
---------------------------------------------------------------------

Shoot.OnServerEvent:Connect(function(player: Player, payload: any)
	local ok, err = pcall(function()
		processShot(player, payload)
	end)

	if not ok then
		warn(string.format(
			"[SoftboyzCombat] Shot error for %s: %s",
			player.Name,
			tostring(err)
		))
	end
end)

---------------------------------------------------------------------
-- RELOAD
---------------------------------------------------------------------

local Reload = Remotes:FindFirstChild("Reload") :: RemoteEvent?

if not Reload then
	Reload = Instance.new("RemoteEvent")
	Reload.Name = "Reload"
	Reload.Parent = Remotes
end

local function reloadWeapon(player: Player, weaponName: string)
	local config = WEAPONS[weaponName]
	if not config then
		return
	end

	local equipped = getEquippedWeapon(player)
	if not equipped or equipped.Name ~= weaponName then
		return
	end

	local state = getState(player)
	local weaponState = state.Weapons[weaponName]

	if weaponState.Reloading then
		return
	end

	if weaponState.Ammo >= config.MagazineSize then
		return
	end

	weaponState.Reloading = true
	weaponState.ReloadToken += 1

	local token = weaponState.ReloadToken

	CombatState:FireClient(player, {
		Type = "Reloading",
		Weapon = weaponName,
		Duration = config.ReloadTime,
	})

	task.delay(config.ReloadTime, function()
		if not player.Parent then
			return
		end

		local current = getState(player)
		local currentWeapon = current.Weapons[weaponName]

		if currentWeapon.ReloadToken ~= token then
			return
		end

		currentWeapon.Reloading = false
		currentWeapon.Ammo = config.MagazineSize

		CombatState:FireClient(player, {
			Type = "Ammo",
			Weapon = weaponName,
			Ammo = currentWeapon.Ammo,
			MagazineSize = config.MagazineSize,
		})
	end)
end

Reload.OnServerEvent:Connect(function(player: Player, weaponName: any)
	if typeof(weaponName) ~= "string" then
		violation(player, "invalid_reload_weapon")
		return
	end

	reloadWeapon(player, weaponName)
end)

---------------------------------------------------------------------
-- PLAYER LIFECYCLE
---------------------------------------------------------------------

Players.PlayerAdded:Connect(function(player)
	states[player] = createPlayerState()
end)

Players.PlayerRemoving:Connect(function(player)
	states[player] = nil
end)

for _, player in ipairs(Players:GetPlayers()) do
	states[player] = createPlayerState()
end

