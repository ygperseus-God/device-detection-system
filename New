-- REMOTE STATE
---------------------------------------------------------------------

CombatState.OnClientEvent:Connect(function(data)
	if typeof(data) ~= "table" then
		return
	end

	if data.Type == "Ammo" then
		local weapon = data.Weapon

		if typeof(weapon) == "string" and typeof(data.Ammo) == "number" then
			ammo[weapon] = data.Ammo
		end

		reloading = false
		updateHUD()

	elseif data.Type == "Reloading" then
		reloading = true

		statusLabel.Text = string.format(
			"%s // RELOADING",
			tostring(data.Weapon)
		)

	elseif data.Type == "Security" then
		statusLabel.Text = "SOFTBOYZ // REQUEST REJECTED"
	end
end)

---------------------------------------------------------------------
-- VISUAL SHOT REPLICATION
---------------------------------------------------------------------

local function createTracer(origin: Vector3, target: Vector3)
	local distance = (target - origin).Magnitude

	if distance <= 0.05 then
		return
	end

	local part = Instance.new("Part")
	part.Name = "SoftboyzTracer"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Material = Enum.Material.Neon
	part.Transparency = 0.15
	part.Size = Vector3.new(0.055, 0.055, distance)

	part.CFrame = CFrame.lookAt(
		(origin + target) * 0.5,
		target
	)

	part.Parent = workspace

	Debris:AddItem(part, 0.08)
end

local function createHitMarker(position: Vector3, headshot: boolean)
	local markerPart = Instance.new("Part")
	markerPart.Name = "SoftboyzHit"
	markerPart.Anchored = true
	markerPart.CanCollide = false
	markerPart.CanQuery = false
	markerPart.CanTouch = false
	markerPart.Transparency = 1
	markerPart.Size = Vector3.new(0.1, 0.1, 0.1)
	markerPart.Position = position
	markerPart.Parent = workspace

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(120, 40)
	billboard.StudsOffset = Vector3.new(0, 1.7, 0)
	billboard.AlwaysOnTop = true
	billboard.Adornee = markerPart
	billboard.Parent = gui

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = headshot and "HEADSHOT" or "HIT"
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.2
	label.Font = Enum.Font.GothamBold
	label.TextSize = 16
	label.Parent = billboard

	Debris:AddItem(markerPart, 0.45)
	Debris:AddItem(billboard, 0.45)
end

ReplicateShot.OnClientEvent:Connect(function(data)
	if typeof(data) ~= "table" then
		return
	end

	if data.Type ~= "Shot" then
		return
	end

	if typeof(data.Origin) == "Vector3"
		and typeof(data.HitPosition) == "Vector3"
	then
		createTracer(
			data.Origin,
			data.HitPosition
		)
	end

	if data.Player == LocalPlayer and data.Hit == true then
		if typeof(data.HitPosition) == "Vector3" then
			createHitMarker(
				data.HitPosition,
				data.Headshot == true
			)
		end
	end
end)

