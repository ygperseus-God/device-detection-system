---------------------------------------------------------------------
-- HELPERS
---------------------------------------------------------------------

local function getCharacter(): Model?
	return LocalPlayer.Character
end

local function getMuzzlePosition(): Vector3?
	local character = getCharacter()
	if not character then
		return nil
	end

	local muzzle = character:FindFirstChild("Muzzle", true)

	if muzzle and muzzle:IsA("BasePart") then
		return muzzle.Position
	end

	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head.Position
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end

	return nil
end

local function getCurrentWeapon(): Tool?
	local character = getCharacter()

	if not character then
		return nil
	end

	for _, object in ipairs(character:GetChildren()) do
		if object:IsA("Tool") and WEAPON_NAMES[object.Name] then
			return object
		end
	end

	return nil
end

local function updateHUD()
	local tool = getCurrentWeapon()
	equippedTool = tool

	if not tool then
		ammoLabel.Text = "--"
		statusLabel.Text = "SOFTBOYZ // NO WEAPON"
		return
	end

	local weaponName = tool.Name
	local currentAmmo = ammo[weaponName]

	if currentAmmo == nil then
		currentAmmo = tool:GetAttribute("Ammo")
	end

	local magazine = tool:GetAttribute("magazineSize")

	if typeof(currentAmmo) == "number" and typeof(magazine) == "number" then
		ammoLabel.Text = string.format(
			"%d / %d",
			currentAmmo,
			magazine
		)
	elseif typeof(currentAmmo) == "number" then
		ammoLabel.Text = tostring(currentAmmo)
	else
		ammoLabel.Text = weaponName
	end

	statusLabel.Text = reloading
		and string.format("%s // RELOADING", weaponName)
		or string.format("%s // READY", weaponName)
end

---------------------------------------------------------------------
-- SHOT
---------------------------------------------------------------------

local function fireOnce()
	if reloading then
		return
	end

	local tool = getCurrentWeapon()
	if not tool then
		return
	end

	local character = getCharacter()
	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end

	local origin = getMuzzlePosition()
	if not origin then
		return
	end

	local viewport = Camera.ViewportSize
	local center = Vector2.new(
		viewport.X * 0.5,
		viewport.Y * 0.5
	)

	local ray = Camera:ViewportPointToRay(
		center.X,
		center.Y
	)

	local direction = ray.Direction

	sequence += 1

	Shoot:FireServer({
		weapon = tool.Name,
		origin = origin,
		direction = direction,
		sequence = sequence,
	})
end

---------------------------------------------------------------------
-- RELOAD
---------------------------------------------------------------------

local function reload()
	local tool = getCurrentWeapon()

	if not tool then
		return
	end

	if reloading then
		return
	end

	reloading = true

	Reload:FireServer(tool.Name)

	updateHUD()
end

